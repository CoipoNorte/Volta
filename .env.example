# ============================================================
#  VOLTA · Autoescuela — variables de entorno
#  Copia este archivo:  cp .env.example .env.local
# ============================================================

# ---------- FRONTEND (Vite) ----------
# ¡Ojo! Todo lo que empieza por VITE_ viaja en el bundle público.
# Aquí NO van secretos jamás.

# URL base de tu API (sin barra final)
VITE_API_URL=http://localhost:8000/api

# "false" → el front consume tu API real.
# Cualquier otro valor (o variable ausente) → datos demo de src/lib/data.ts
VITE_USE_MOCK=true


# ============================================================
#  BACKEND (referencia — crea ESTE .env en tu proyecto servidor,
#  no en el frontend). Guía completa: docs/GUIA_BACKEND.md
# ============================================================
#
# # --- Base de datos ---
# DB_URL=postgresql://volta:volta@localhost:5432/volta
#
# # --- Auth JWT ---
# JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# JWT_TTL_MIN=120
#
# # --- SAP Business One (Service Layer) ---
# SAP_SERVICE_LAYER_URL=https://sap-b1.midominio.local:50000/b1s/v1
# SAP_COMPANY_DB=SBODEMOES
# SAP_USER=manager
# SAP_PASS=****
#
# # --- Email transaccional (SMTP / Mailgun) ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=no-reply@volta.auto
# SMTP_PASS=****
#
# # --- WhatsApp Cloud API (Meta) ---
# WHATSAPP_TOKEN=EAAG****
# WHATSAPP_PHONE_ID=1234567890
#
# # --- Pasarela de pago ---
# STRIPE_SECRET_KEY=sk_test_****
# STRIPE_WEBHOOK_SECRET=whsec_****
# # (alternativa ES) REDSYS_MERCHANT_CODE / REDSYS_SECRET
#
# # --- Almacenamiento de documentos (S3 compatible) ---
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=volta-documentos
# S3_ACCESS_KEY=AKIA****
# S3_SECRET_KEY=****
